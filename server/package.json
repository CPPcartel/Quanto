{
  "name": "quanto-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test:db": "tsc -p tsconfig.json && node scripts/test-db.mjs",
    "import": "node scripts/import-sqlite.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "test:market": "npm run build && node scripts/test-market.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test": "npm run build && node scripts/test-db.mjs && node scripts/test-territory.mjs && node scripts/test-market.mjs && node scripts/test-parks.mjs && node scripts/test-charge.mjs && node scripts/test-city-overlap.mjs && node scripts/test-shifts.mjs && node scripts/test-nft.mjs && node scripts/test-club.mjs && node scripts/test-chat.mjs && node scripts/test-messages.mjs && node scripts/test-ledger-sync.mjs && node scripts/test-wallets.mjs && node scripts/test-seasons.mjs && node scripts/test-profiles.mjs",
    "test:messages": "npm run build && node scripts/test-messages.mjs",
    "test:messages:live": "node scripts/test-messages-live.mjs",
    "repair:balances": "node scripts/repair-balances.mjs",
    "db:purge-test": "node scripts/purge-test-data.mjs",
    "test:wallets": "npm run build && node scripts/test-wallets.mjs",
    "test:seasons": "npm run build && node scripts/test-seasons.mjs",
    "test:prizes": "node scripts/test-prizes.mjs",
    "seed:season": "node scripts/seed-closed-season.mjs",
    "test:profiles": "npm run build && node scripts/test-profiles.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.16.25",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "0.16.5",
    "@privy-io/server-auth": "^1.32.5",
    "express": "latest",
    "postgres": "^3.4.9",
    "viem": "^2.55.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/express": "latest",
    "@types/node": "latest",
    "colyseus.js": "^0.16.22",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "@colyseus/greeting-banner": "2.0.6"
  }
}
