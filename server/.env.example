# ---------------------------------------------------------------------------
# Quanto — game server
#
# Copy to .env and fill in. Everything here is OPTIONAL: with none of it set the
# server runs a local PGlite database, guest-only accounts, and no NFT tiers —
# which is exactly what local development wants.
# ---------------------------------------------------------------------------

# Port to listen on. Railway and Render inject this automatically.
PORT=2567

# The client's origin, for CORS. Unset means "any origin" — local dev only.
ALLOWED_ORIGIN=https://your-client.vercel.app

# Players sharing one city before Colyseus opens a SECOND room. Players in
# different rooms cannot see each other, so raising this keeps one shared city;
# the ceiling is bandwidth, not CPU.
MAX_PLAYERS=150


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set DATABASE_URL and the server uses Postgres (Supabase, Neon, RDS…).
# Leave it unset and it uses PGlite — real Postgres compiled to WebAssembly —
# in DATA_DIR. Same SQL either way.
#
# Use the SESSION POOLER connection string from Supabase, not the direct one:
# the direct host is IPv6-only and most hosts cannot reach it.
DATABASE_URL=

# Where the local PGlite database lives when DATABASE_URL is unset. On a host
# with ephemeral disk this MUST point at a mounted volume or every redeploy
# wipes the city.
DATA_DIR=./data

# Postgres connection pool size. Keep it small on Supabase's free tier.
DB_POOL=8


# ---------------------------------------------------------------------------
# Accounts (Privy)
# ---------------------------------------------------------------------------
# Both required together, or the server stays guest-only. The SECRET must never
# reach the browser — note there is no VITE_ prefix here, and there must not be:
# anything prefixed VITE_ is compiled into the client bundle and is public.
# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Require a verified account to enter the city. ON by default.
#
# With this on the server REFUSES TO START unless PRIVY_APP_ID and
# PRIVY_APP_SECRET are also set — a server that requires a login it cannot
# verify would be up, healthy and impossible to join.
#
# Set REQUIRE_AUTH=false only for local development, where it restores the
# original guest play.
REQUIRE_AUTH=true
PRIVY_APP_ID=
PRIVY_APP_SECRET=


# ---------------------------------------------------------------------------
# On-chain
# ---------------------------------------------------------------------------
# The Quanto Residents ERC-721, once deployed via OpenSea Studio. Unset
# means nobody holds a tier and the game behaves exactly as it does today.
COLLECTION_ADDRESS=

# Override the Robinhood Chain RPC. Defaults to the public mainnet endpoint;
# set this to a private endpoint if you hit rate limits.
RPC_URL=


# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------
# Days of chat history kept. Set to 0 to disable pruning entirely — but the log
# is the fastest-growing table in the database, and managed Postgres tiers are
# size-capped.
CHAT_RETENTION_DAYS=30

# Required to call POST /debug/storm/:symbol in production. Unset leaves the
# endpoint OPEN, which is fine locally and is not fine on a public server.
DEBUG_TOKEN=
