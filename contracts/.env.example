# ---------------------------------------------------------------------------
# Candlestick City — contract deployment
#
# Copy to .env. THIS FILE'S REAL COUNTERPART HOLDS A PRIVATE KEY.
#   - .env is gitignored. Verify that before you paste anything into it.
#   - Never print it, paste it into a chat, or commit it.
#   - Treat the deploy key as disposable: it should hold only enough ETH for
#     gas, and it hands ownership away at the end of the deploy.
# ---------------------------------------------------------------------------

# The deploying account's private key, 0x-prefixed.
# Generate a fresh one with:  node scripts/new-key.cjs
DEPLOYER_KEY=

# The matching address. Informational only — used for the balance readout.
DEPLOYER_ADDRESS=

# Who ends up OWNING the contracts. A hardware wallet or multisig.
#
# REQUIRED for mainnet, and the deploy script refuses to run without it — and
# refuses if it equals DEPLOYER_ADDRESS. Leaving the hot key as owner would let
# anyone holding it raise the daily emission cap, which is the one protection
# enforced on-chain rather than in game logic.
OWNER_ADDRESS=

# The game server's address, authorised to settle wage batches. Optional at
# deploy time; the owner can set it later.
SETTLER_ADDRESS=

# Chainlink L2 sequencer uptime feed. None exists for Robinhood Chain, so this
# stays unset and OracleRouter skips that check. Deliberate, not an oversight.
SEQUENCER_FEED=
