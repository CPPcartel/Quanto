# ---------------------------------------------------------------------------
# Candlestick City — web client
#
# EVERYTHING HERE IS PUBLIC. Vite compiles any VITE_-prefixed variable into the
# browser bundle, where anyone can read it. Never put a secret here — the Privy
# App Secret and the database URL belong to the server and must not appear in
# this file under any name.
# ---------------------------------------------------------------------------

# The deployed game server. Must be wss:// in production — a page served over
# https cannot open an insecure ws:// socket; browsers block it as mixed
# content. Local dev needs nothing here; the default is ws://localhost:2567.
VITE_SERVER_URL=wss://your-server.up.railway.app

# Privy app id. Public by design — it identifies the app, it does not authorise
# anything. Unset means the game runs guest-only and never loads Privy at all,
# which also keeps ~1.2MB out of the landing page bundle.
VITE_PRIVY_APP_ID=
